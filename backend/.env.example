# ==========================================================
#  Copy this file to backend/.env and fill in real values.
#  backend/.env is gitignored and must never be committed.
# ==========================================================

# --- Server -----------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Production refuses to boot with a short or placeholder JWT_SECRET, so
# generate one for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Database ---------------------------------------------------------------

# MongoDB Atlas:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/abu_rabie?retryWrites=true&w=majority
# Local MongoDB:
#   mongodb://127.0.0.1:27017/abu_rabie
#
# If the password contains @ : / ? # [ ] %, percent-encode it.
MONGODB_URI=mongodb://127.0.0.1:27017/abu_rabie

# --- Authentication ---------------------------------------------------------

# Must be at least 32 characters in production.
JWT_SECRET=abu_rabie_secret_key_development_2026_replace_me
JWT_EXPIRES_IN=7d

# --- Initial admin account (created by `npm run seed`) ----------------------
#
# The seeder refuses to run in production while ADMIN_PASSWORD is still
# admin123, so pick something strong before the first deploy.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@aburabie.com

# --- Storefront -------------------------------------------------------------

# Number in international format, digits only, no "+" and no spaces.
WHATSAPP_NUMBER=201093044150

# Comma-separated list of origins allowed to call the API.
# In production this must be the real site URL. "*" is refused in production.
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# --- Development-only fallback ----------------------------------------------

# When true and MongoDB is unreachable, controllers read products from
# ../elkhalily_products.json instead of failing. Ignored entirely when
# NODE_ENV=production, where a database outage must be visible.
ALLOW_OFFLINE_MODE=false

# --- Logging ----------------------------------------------------------------

# Request logging is always on in development and off in production.
# Set to true to enable combined-format access logs on a live server.
LOG_REQUESTS=false